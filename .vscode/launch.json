{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TalkSphere",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--locked", "--bin", "talksphere"],
                "filter": {
                    "name": "talksphere",
                    "kind": "bin"
                }
            },
            "args": ["--help"],
            "cwd": "${workspaceFolder}"
        }
    ]
}
