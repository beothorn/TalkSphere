{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build TalkSphere Debug",
            "type": "shell",
            "command": "make",
            "args": [
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/project/TalkSphere/linux"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build TalkSphere Release",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/project/TalkSphere/linux"
            },
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Test TalkSphere",
            "type": "shell",
            "command": "make",
            "args": [
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}/project/TalkSphere/linux"
            },
            "group": "test",
            "problemMatcher": "$gcc"
        }
    ]
}
