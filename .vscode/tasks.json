{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build TalkSphere Debug",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--locked"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$rustc"
        },
        {
            "label": "Build TalkSphere Release",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--locked", "--release"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$rustc"
        },
        {
            "label": "Test TalkSphere",
            "type": "shell",
            "command": "cargo",
            "args": [
                "test",
                "--locked"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": "$rustc"
        }
    ]
}
